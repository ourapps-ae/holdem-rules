{
  "id": "chip-ledger",
  "type": "ae/chip-ledger",
  "version": "1.0.0",
  "notes": "What holdem-rules calls on the chip-ledger component (createHoldem deps.ledger). The ledger's settings sidePots, oddChipRule and minimumUnit decide the pots and the amounts; its seats setting must be at least holdem-rules' seats.",
  "operations": {
    "validateSettings": {
      "arguments": [
        "settings?:Partial<LedgerSettings>"
      ],
      "returns": "LedgerSettings (only when the hand opens its own ledger)"
    },
    "stakeOf": {
      "arguments": [
        "ledger",
        "id:string"
      ],
      "returns": "Stake {id,seat,stack,bet,totalIn,folded}"
    },
    "commit": {
      "arguments": [
        "ledger",
        "id:string",
        "amount:number"
      ],
      "returns": "{ledger,committed:number} (blinds, calls, bets, raises, all-ins)"
    },
    "fold": {
      "arguments": [
        "ledger",
        "id:string"
      ],
      "returns": "Ledger"
    },
    "endRound": {
      "arguments": [
        "ledger"
      ],
      "returns": "Ledger (at each new street)"
    },
    "returnUncalled": {
      "arguments": [
        "ledger"
      ],
      "returns": "{ledger,returned} (before the pots are built)"
    },
    "buildPots": {
      "arguments": [
        "ledger"
      ],
      "returns": "Pot[] (one pot when sidePots is off; folded chips above the top live layer go into the last pot)"
    },
    "displayPots": {
      "arguments": [
        "ledger"
      ],
      "returns": "Pot[] (pots shown mid-round)"
    },
    "awardPot": {
      "arguments": [
        "ledger",
        "pot:Pot",
        "winners:string[]",
        "button:number"
      ],
      "returns": "Award (odd chips by oddChipRule)"
    },
    "settle": {
      "arguments": [
        "ledger",
        "awards:Award[]"
      ],
      "returns": "Ledger (stacks paid, wagers cleared)"
    },
    "voidHand": {
      "arguments": [
        "ledger"
      ],
      "returns": "Ledger (every wager returned)"
    },
    "nextHand": {
      "arguments": [
        "ledger"
      ],
      "returns": "Ledger (folded marks cleared at the start of a round)"
    }
  }
}
